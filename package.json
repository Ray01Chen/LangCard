{
  "name": "langcard",
  "version": "1.0.0",
  "private": true,
  "description": "Buildless multilingual flashcards with JSON backups and Google Translate pronunciation.",
  "scripts": {
    "check": "node scripts/check-all.cjs",
    "check:data": "node scripts/check-data.cjs",
    "check:json": "node scripts/check-json.cjs",
    "lint": "eslint dist scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  }
}
